# ==== Пересказ / перевод на русский ====
# Провайдер: openai | claude | deepl | libretranslate | mock
# openai — экономичный самостоятельный пересказ через GPT-5 nano.
# claude — альтернативный ИИ-провайдер. Оба режима создают не дословный перевод,
# а самостоятельный пересказ
# сути своими словами (см. src/openAiRetell.js и src/aiRetell.js) — дешевле и безопаснее с точки
# зрения авторского права, чем переводить текст 1:1.
RUSSIAN_PROVIDER=openai

# Создайте новый ключ в OpenAI Platform и храните только как secret в Coolify.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# Ключ Claude API. Получить: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Модель для пересказа. claude-haiku-4-5-20251001 — самая дешёвая из текущих
# моделей ($1/$5 за million tokens), для короткого пересказа заголовка и
# описания её точности достаточно с большим запасом.
# При желании более "литературного" пересказа можно поставить
# claude-sonnet-4-6 (дороже примерно в 3 раза, но качественнее стиль).
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- Альтернативы (если решите не использовать Claude) ----
# DeepL — дословный перевод, платно после 500k символов/мес
DEEPL_API_KEY=
# LibreTranslate — стабильный self-hosted резерв, если вы развернули его отдельно.
# Оставьте пустым, если такого сервиса нет.
RUSSIAN_FALLBACK_PROVIDER=
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# Аварийный бесплатный резерв: google | off.
# При google он включается только если у OpenAI отсутствует ключ или закончилась
# квота. Ключ не нужен, но это публичный неофициальный endpoint без SLA:
# используйте его как временную страховку, а не как основной переводчик.
RUSSIAN_FREE_FALLBACK=google

# ==== Сервер ====
PORT=3000
# Даты отложенной публикации в админке интерпретируются в этом часовом поясе.
TZ=Europe/Helsinki

# CORS выключен по умолчанию. Для браузерных клиентов укажите origin через запятую.
# Пример: https://finskienovosti.fi,https://www.finskienovosti.fi
CORS_ORIGIN=

# Токен для POST /api/news/refresh. Без токена ручное обновление отключено.
REFRESH_TOKEN=
# Минимальная пауза между успешными ручными обновлениями.
REFRESH_COOLDOWN_SECONDS=60

# HTTP Basic Auth для /admin. Старый единый аккаунт остаётся совместимым.
ADMIN_USER=
ADMIN_PASSWORD=

# Дополнительные отдельные аккаунты редакторов в JSON. Роли: admin | editor.
# editor ведёт материалы, комментарии, импорт, статистику и Telegram;
# только admin может безвозвратно удалять статьи и комментарии.
# Пароли сюда в репозиторий не записывайте — задайте значение как secret в Coolify.
# Пример: [{"username":"editor","password":"replace-with-strong-secret","role":"editor"}]
ADMIN_ACCOUNTS_JSON=

# Рекомендуемый вход в /admin через Google OpenID Connect.
# В Google Cloud создайте OAuth Client типа Web application и добавьте точный
# redirect URI examples:
#   https://finskienovosti.fi/admin/auth/google/callback
#   https://www.finskienovosti.fi/admin/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Публичный пользовательский вход использует те же Google OAuth credentials.
# Redirect URI: https://YOUR_SITE/account/auth/google/callback
# Отдельные разрешённые Google-аккаунты и роли. Храните как secret в Coolify.
# Назначьте владельцу role=admin, остальным сотрудникам role=editor.
# Пример: [{"email":"owner@gmail.com","role":"admin"},{"email":"editor@gmail.com","role":"editor"}]
ADMIN_GOOGLE_ACCOUNTS_JSON=
# Упрощённый allowlist через запятую; такие адреса получают роль admin.
ADMIN_GOOGLE_EMAILS=
# Продолжительность защищённой сессии редактора: 1–168 часов.
ADMIN_SESSION_HOURS=12

# Ручная отправка статей в Telegram из /admin. Без обеих переменных отправка отключена.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Необязательно: username без @. Если не задан, сайт получит имя через Bot API getMe.
TELEGRAM_BOT_USERNAME=
# Оставьте официальный URL; меняйте только для локального mock Telegram API.
TELEGRAM_API_BASE_URL=https://api.telegram.org
# Необязательный секрет для проверки webhook Telegram. Если не задан,
# сервер безопасно вычислит его из токена бота.
TELEGRAM_WEBHOOK_SECRET=
# Для персональных подписок сервер сам настроит webhook на:
# https://YOUR_SITE/telegram/webhook. SITE_URL должен использовать HTTPS.

# Для Coolify за одним reverse proxy установите 1, чтобы получить IP клиента из X-Forwarded-For.
# Вне доверенного reverse proxy оставьте 0.
TRUST_PROXY=0

# Лимит публикации комментариев с одного IP-адреса.
COMMENT_RATE_LIMIT_WINDOW_SECONDS=600
COMMENT_RATE_LIMIT_MAX=3

# Сколько дней хранить анонимные дневные просмотры и реакции. Более старые записи
# удаляются при старте и ежедневно в 00:15 UTC.
ANALYTICS_RETENTION_DAYS=90

# Как часто обновлять новости из RSS (в минутах)
REFRESH_INTERVAL_MINUTES=15

# Путь к локальной SQLite-базе
DATABASE_PATH=data/finskienovosti.db
BACKUP_DIRECTORY=data/backups

SITE_URL=http://localhost:3000
